# Database
DATABASE_URL="postgresql://user:password@localhost:5432/neighbours_club?schema=public"

# Auth (used in Step 2)
# Generate with: openssl rand -base64 32  OR  npx auth secret
AUTH_SECRET=""

# Stripe (used in Step 4)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""   # Same value as STRIPE_PUBLISHABLE_KEY — must be prefixed NEXT_PUBLIC_ for browser access
STRIPE_WEBHOOK_SECRET=""    # From `stripe listen` output (local) or Stripe Dashboard → Webhooks (production)

# Email — Resend (used in Step 7)
RESEND_API_KEY=""
EMAIL_FROM="Neighbours Club <hello@neighborsclub.ca>"

# Cron job security — shared by ALL cron endpoints (group buy + delivery dispatch)
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# Delivery dispatch — shipping adapter
# Set to "true" in development to use the local stub (no Uber credentials needed).
# Must be "false" or unset in production so the real Uber webhook drives state transitions.
USE_SHIPPING_STUB="true"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# CASL compliance — physical address printed in all subscriber emails
NEIGHBOURS_CLUB_ADDRESS=""
