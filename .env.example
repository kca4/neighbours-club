# Database
DATABASE_URL="postgresql://user:password@localhost:5432/neighbours_club?schema=public"

# Auth (used in Step 2)
# Generate with: openssl rand -base64 32  OR  npx auth secret
AUTH_SECRET=""

# Stripe (used in Step 4)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""   # Same value as STRIPE_PUBLISHABLE_KEY — must be prefixed NEXT_PUBLIC_ for browser access
STRIPE_WEBHOOK_SECRET=""    # From `stripe listen` output (local) or Stripe Dashboard → Webhooks (production)

# Email — Resend (used in Step 7)
RESEND_API_KEY=""
EMAIL_FROM="Neighbours Club <hello@neighboursclub.ca>"

# Cron job security (used in Step 6)
CRON_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# CASL compliance — physical address printed in all subscriber emails
NEIGHBOURS_CLUB_ADDRESS=""
