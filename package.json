{
  "name": "neighbours_club",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:delivery": "tsx prisma/seeds/delivery-seed.ts",
    "seed:restaurants": "tsx scripts/seed-restaurants.ts",
    "dispatch:sweep": "curl -s -H \"Authorization: Bearer $CRON_SECRET\" http://localhost:3000/api/dispatch/cron-sweep | cat",
    "verify:cp": "NODE_OPTIONS=\"--conditions=react-server\" tsx scripts/verify-cp.ts",
    "seed:test-note": "tsx prisma/seeds/test-note.ts",
    "seed:test-notes-faucet": "tsx prisma/seeds/test-notes-faucet.ts",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.2.0",
    "@prisma/client": "^5.22.0",
    "@stripe/react-stripe-js": "^6.2.0",
    "@stripe/stripe-js": "^9.3.1",
    "@tanstack/react-query": "^5.100.14",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.2",
    "rss-parser": "^3.13.0",
    "server-only": "^0.0.1",
    "stripe": "^22.1.0",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
