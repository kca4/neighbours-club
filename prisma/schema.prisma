generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  MEMBER
  ADMIN
  RESTAURANT_OWNER
  COURIER
}

enum DealStatus {
  DRAFT
  OPEN
  CLOSING_SUCCESS
  CLOSING_FAILED
  FULFILLING
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING_AUTHORIZATION
  AUTHORIZED
  CAPTURED
  CAPTURE_FAILED
  VOIDED
  PICKED_UP
  REFUNDED
  NO_SHOW
}

enum DeliveryOrderStatus {
  pending
  accepted
  cooking
  ready
  picked_up
  on_the_way
  delivered
  cancelled
}

enum PartnerApplicationStatus {
  in_progress
  submitted
  approved
  rejected
}

enum NoteStatus {
  DRAFT
  APPROVED
  PUBLISHED
}

enum NoteCategory {
  Transit
  DevApp
  Safety
  Social
  Cost
  Weather
  Other
}

// ─── Core Models ──────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String
  firstName        String?
  phone            String?
  role             Role      @default(MEMBER)
  stripeCustomerId String?   @unique

  // Address for delivery orders
  deliveryAddressLine1 String?
  deliveryAddressLine2 String?
  deliveryAddressCity  String?
  deliveryAddressPostal String?

  // Neighbourhood membership
  neighbourhoodId  String?
  neighbourhood    Neighbourhood? @relation(fields: [neighbourhoodId], references: [id])

  // Onboarding
  hasCompletedOnboarding Boolean @default(false)

  // Driver fields
  isOnline         Boolean   @default(false)
  restaurantId     String?   // if RESTAURANT_OWNER, their restaurant

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  orders              Order[]
  createdDeals        Deal[]           @relation("DealCreator")
  resetTokens         PasswordResetToken[]
  deliveryOrders      DeliveryOrder[]  @relation("CustomerOrders")
  driverOrders        DeliveryOrder[]  @relation("DriverOrders")
  noteReactions       NoteReaction[]
  notesSubscription   NotesSubscriber?
  partnerApplication  PartnerApplication?
  savedNotes          SavedNote[]
  neighbourhoodWaitlist NeighbourhoodWaitlist[]
  restaurant          Restaurant?      @relation("RestaurantOwner")

  @@index([neighbourhoodId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ─── Group-buy Models (existing) ──────────────────────────────────────────────

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  contactEmail String?
  contactPhone String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deals       Deal[]
}

model Deal {
  id                  String     @id @default(cuid())
  title               String
  slug                String     @unique
  description         String     @db.Text
  imageUrl            String?

  supplierId          String
  supplier            Supplier   @relation(fields: [supplierId], references: [id])

  createdById         String
  createdBy           User       @relation("DealCreator", fields: [createdById], references: [id])

  tiers               DealTier[]
  minimumMembers      Int
  maximumMembers      Int?
  maxQuantityPerMember Int       @default(1)

  opensAt             DateTime
  closesAt            DateTime

  pickupLocation      String
  pickupAddress       String
  pickupWindowStart   DateTime
  pickupWindowEnd     DateTime
  pickupInstructions  String?    @db.Text

  status              DealStatus @default(DRAFT)
  finalPrice          Decimal?   @db.Decimal(10, 2)
  finalTierIndex      Int?
  midpointReminderSentAt DateTime?
  closingProcessedAt  DateTime?

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  orders              Order[]

  @@index([status, closesAt])
  @@index([slug])
}

model DealTier {
  id              String   @id @default(cuid())
  dealId          String
  deal            Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  minMembers      Int
  maxMembers      Int?
  pricePerUnit    Decimal  @db.Decimal(10, 2)
  tierOrder       Int

  @@unique([dealId, tierOrder])
  @@index([dealId])
}

model Order {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id])

  dealId            String
  deal              Deal        @relation(fields: [dealId], references: [id])

  quantity          Int
  maxAuthorizedAmount Decimal   @db.Decimal(10, 2)
  finalAmount       Decimal?    @db.Decimal(10, 2)

  stripePaymentIntentId String? @unique
  recoveryToken     String?     @unique
  status            OrderStatus @default(PENDING_AUTHORIZATION)

  pickedUpAt        DateTime?
  pickedUpBy        String?
  pickupReminderSentAt DateTime?
  notes             String?     @db.Text

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([userId, dealId])
  @@index([dealId, status])
  @@index([userId])
}

// ─── Delivery / Restaurant Models ─────────────────────────────────────────────

model Neighbourhood {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  city        String   @default("Ottawa")
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  restaurants   Restaurant[]
  waitlist      NeighbourhoodWaitlist[]

  @@index([slug])
}

model Restaurant {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  cuisine         String
  address         String
  phone           String?
  hours           Json     @default("{}")
  description     String?  @db.Text
  ownerName       String?
  ownerQuote      String?
  heroImageUrl    String?
  logoUrl         String?
  isActive        Boolean  @default(false)
  isPaused        Boolean  @default(false)
  rating          Decimal? @db.Decimal(3, 2)
  reviewCount     Int      @default(0)
  estimatedMinMin Int      @default(25)
  estimatedMinMax Int      @default(35)

  neighbourhoodId String?
  neighbourhood   Neighbourhood? @relation(fields: [neighbourhoodId], references: [id])

  // Owner link
  ownerId         String?  @unique
  owner           User?    @relation("RestaurantOwner", fields: [ownerId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  menuItems       MenuItem[]
  deliveryOrders  DeliveryOrder[]

  @@index([slug])
  @@index([neighbourhoodId, isActive])
}

model MenuItem {
  id           String  @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  price        Decimal @db.Decimal(10, 2)
  category     String
  tags         String[]
  imageUrl     String?
  colorHex     String?
  isAvailable  Boolean @default(true)
  sortOrder    Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([restaurantId, category])
}

model DeliveryOrder {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation("CustomerOrders", fields: [userId], references: [id])

  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id])

  driverId        String?
  driver          User?    @relation("DriverOrders", fields: [driverId], references: [id])

  // Items snapshot (JSON so prices are locked at order time)
  items           Json

  subtotal        Decimal  @db.Decimal(10, 2)
  deliveryFee     Decimal  @db.Decimal(10, 2)
  serviceFee      Decimal  @db.Decimal(10, 2)
  tax             Decimal  @db.Decimal(10, 2)
  tip             Decimal  @db.Decimal(10, 2)
  tipPct          Int?
  total           Decimal  @db.Decimal(10, 2)

  status          DeliveryOrderStatus @default(pending)

  stripePaymentIntentId String? @unique

  // Address snapshot (JSON so user can change address later without affecting history)
  deliveryAddress Json

  driverNote      String?  @db.Text

  // Timing
  estimatedDeliveryAt DateTime?
  acceptedAt          DateTime?
  cookingStartedAt    DateTime?
  readyAt             DateTime?
  pickedUpAt          DateTime?
  deliveredAt         DateTime?

  // Photo proof
  pickupPhotoUrl   String?
  dropoffPhotoUrl  String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([restaurantId, status])
  @@index([driverId, status])
}

// ─── Notes / Editorial Models ─────────────────────────────────────────────────

model NoteReaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issueId   String
  reaction  String   // "love" | "fire" | "thanks" | "cozy"
  createdAt DateTime @default(now())

  @@unique([userId, issueId])
  @@index([issueId])
}

model NotesSubscriber {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String   @unique
  createdAt DateTime @default(now())
}

model SavedNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issueId   String
  createdAt DateTime @default(now())

  @@unique([userId, issueId])
}

// ─── Partner Onboarding ───────────────────────────────────────────────────────

model PartnerApplication {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  currentStep     Int      @default(1)
  isSubmitted     Boolean  @default(false)
  overallStatus   PartnerApplicationStatus @default(in_progress)

  // Step 1 — About the restaurant
  restaurantName  String?
  cuisine         String?
  address         String?
  phone           String?
  email           String?

  // Step 2 — Owner info
  ownerName       String?
  businessNumber  String?

  // Step 3 — Hours
  hours           Json?

  // Step 4 — Menu
  menuMethod      String?   // "bulk" | "manual"
  menuItems       Json?
  menuBulkUrl     String?   // Vercel Blob URL for uploaded PDF/image
  menuBulkText    String?   @db.Text

  // Step 5 — Photos
  photosSkipped   Boolean   @default(false)
  logoUrl         String?
  heroPhotoUrl    String?

  // Step 6 — Stripe Connect
  stripeConnectId String?

  // Step 7 — Call scheduling
  callSlot        String?

  // Neighbourhood
  neighbourhoodId String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([overallStatus])
}

// ─── Neighbourhood Waitlist ───────────────────────────────────────────────────

model NeighbourhoodWaitlist {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email           String
  neighbourhoodId String
  neighbourhood   Neighbourhood @relation(fields: [neighbourhoodId], references: [id])
  createdAt       DateTime @default(now())

  @@unique([email, neighbourhoodId])
  @@index([neighbourhoodId])
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
}

// ─── Neighbours Notes: Raw Intel ──────────────────────────────────────────────

model RawIntel {
  id            String         @id @default(cuid())
  sourceId      String
  sourceUrl     String         @unique
  title         String
  body          String         @db.Text
  publishedAt   DateTime?
  ingestedAt    DateTime       @default(now())
  processed     Boolean        @default(false)
  processedNote ProcessedNote?

  @@map("raw_intel")
}

model ProcessedNote {
  id                  String       @id @default(cuid())
  rawIntelId          String       @unique
  rawIntel            RawIntel     @relation(fields: [rawIntelId], references: [id])
  headline            String
  summary             String       @db.Text
  streetOrArea        String
  category            NoteCategory
  impactSafety        Int
  impactCost          Int
  impactTime          Int
  riskScore           Int
  autoPublishEligible Boolean
  status              NoteStatus   @default(DRAFT)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("processed_notes")
}
