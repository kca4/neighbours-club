{
  "crons": [
    {
      "path": "/api/dispatch/cron-sweep",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/close-deals",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/cleanup-pending-orders",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/send-pickup-reminders",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/ingest-notes",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/send-daily-digest",
      "schedule": "0 11 * * *"
    }
  ]
}
